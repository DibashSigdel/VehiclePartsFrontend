@inherits LayoutComponentBase
@inject AuthStateService AuthStateService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 top-row-bar top-row-vp">
            <div class="top-row-left">
                <span class="top-row-kicker">Workshop &amp; inventory</span>
                <div class="top-row-title" role="presentation">Vehicle Parts Management Suite</div>
            </div>
            @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser is not null)
            {
                <div class="top-row-user" title="@AuthStateService.CurrentUser.Email">
                    <span class="top-row-user-avatar" aria-hidden="true">@GetUserInitial()</span>
                    <span class="top-row-user-name">@AuthStateService.CurrentUser.Name</span>
                    <span class="vp-role-chip">@AuthStateService.CurrentUser.Role</span>
                </div>
            }
        </div>

        <article class="content px-4 main-content-surface vp-app-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string GetUserInitial()
    {
        var name = AuthStateService.CurrentUser?.Name;
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }
}

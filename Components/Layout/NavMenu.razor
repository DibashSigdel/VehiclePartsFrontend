@inject AuthStateService AuthStateService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-dot"></span>
            VehiclePartsSystem
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column nav-list">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser?.Role == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="register">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Register User
                </NavLink>
            </div>
        }

        @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser?.Role == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Manage Staff & Roles
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/vendors">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Manage Vendors
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/parts">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Manage Parts
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/purchase-invoices">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Purchase invoices
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/financial-reports">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Financial reports
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/system-alerts">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> System alerts
                </NavLink>
            </div>
        }

        @if (AuthStateService.IsLoggedIn && (AuthStateService.CurrentUser?.Role == "Staff" || AuthStateService.CurrentUser?.Role == "Admin"))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="staff/sales-invoices">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sales invoices
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="staff/customers/register">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Register Customer
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="staff/customer-reports">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Customer reports
                </NavLink>
            </div>
        }

        @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser?.Role == "Customer")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer/profile">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My Profile
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer/vehicles">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My Vehicles
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer/services">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Book &amp; request services
                </NavLink>
            </div>
        }

        @if (!AuthStateService.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer/register">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Customer Register
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }

        @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser is not null)
        {
            <div class="nav-item px-3 user-info-item">
                <span class="nav-link user-info-chip">
                    @AuthStateService.CurrentUser.Name
                    <span class="user-role-pill">@AuthStateService.CurrentUser.Role</span>
                </span>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link nav-action-btn" @onclick="Logout">Logout</button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthStateService.StateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        AuthStateService.Logout();
    }

    public void Dispose()
    {
        AuthStateService.StateChanged -= HandleStateChanged;
    }
}
@page "/admin/financial-reports"
@rendermode InteractiveServer
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService

<PageTitle>Financial reports</PageTitle>

@if (AuthStateService.CurrentUser?.Role != "Admin")
{
    <section class="dashboard-card">
        <p class="status-text">Admin access required.</p>
    </section>
}
else
{
    <section class="admin-page-head">
        <div>
            <h1 class="admin-page-title">Financial reports</h1>
            <p class="subtitle">View sales revenue, purchase costs, and profit by day, month, or year.</p>
        </div>
    </section>

    <section class="dashboard-card mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Period</label>
                <InputSelect class="form-control" TValue="string" @bind-Value="_period">
                    <option value="daily">Daily</option>
                    <option value="monthly">Monthly</option>
                    <option value="yearly">Yearly</option>
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">From (optional)</label>
                <InputDate class="form-control" TValue="DateTime?" @bind-Value="_from" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To (optional)</label>
                <InputDate class="form-control" TValue="DateTime?" @bind-Value="_to" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="button" disabled="@_isLoading" @onclick="LoadReportAsync">
                    @(_isLoading ? "Loading…" : "Generate report")
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mt-3 status-alert error">@_error</p>
        }
    </section>

    @if (_report is not null)
    {
        <section class="dashboard-card mb-3">
            <h2 class="h5 mb-3">Summary (@_report.Period)</h2>
            <p class="subtitle mb-3">
                @(_report.From.ToLocalTime().ToString("d")) — @(_report.To.ToLocalTime().ToString("d"))
            </p>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="status-chip success">
                        Sales: @NepalCurrency.Npr(_report.TotalSalesRevenue) (@_report.SalesInvoiceCount invoices)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="status-chip neutral">
                        Purchases: @NepalCurrency.Npr(_report.TotalPurchaseCost) (@_report.PurchaseInvoiceCount invoices)
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="status-chip @(_report.GrossProfit >= 0 ? "success" : "error")">
                        Gross profit: @NepalCurrency.Npr(_report.GrossProfit)
                    </div>
                </div>
            </div>
        </section>

        <section class="dashboard-card">
            <h2 class="h5 mb-3">Breakdown</h2>
            @if (_report.Buckets.Count == 0)
            {
                <p class="subtitle">No transactions in this date range.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th class="text-end">Sales</th>
                                <th class="text-end">Purchases</th>
                                <th class="text-end">Profit</th>
                                <th class="text-end"># Sales</th>
                                <th class="text-end"># Purchases</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _report.Buckets)
                            {
                                <tr>
                                    <td>@row.Label</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.SalesRevenue)</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.PurchaseCost)</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.GrossProfit)</td>
                                    <td class="text-end">@row.SalesCount</td>
                                    <td class="text-end">@row.PurchaseCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private string _period = "monthly";
    private DateTime? _from;
    private DateTime? _to;
    private AdminFinancialReportDto? _report;
    private bool _isLoading;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateService.CurrentUser?.Role == "Admin" && !string.IsNullOrEmpty(AuthStateService.CurrentUser.Token))
        {
            await LoadReportAsync();
        }
    }

    private async Task LoadReportAsync()
    {
        if (AuthStateService.CurrentUser?.Token is null)
        {
            return;
        }

        _isLoading = true;
        _error = string.Empty;
        _report = null;

        DateTime? fromUtc = _from.HasValue ? DateTime.SpecifyKind(_from.Value, DateTimeKind.Utc) : null;
        DateTime? toUtc = _to.HasValue
            ? DateTime.SpecifyKind(_to.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc)
            : null;

        _report = await AuthApiService.GetAdminFinancialReportAsync(
            _period,
            AuthStateService.CurrentUser.Token,
            fromUtc,
            toUtc);

        if (_report is null)
        {
            _error = "Could not load report. Check you are logged in as Admin and the API is running.";
        }

        _isLoading = false;
    }
}
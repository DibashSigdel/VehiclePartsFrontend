@page "/customer/history"
@rendermode InteractiveServer
@using VehiclePartsFrontend.Models.Customer
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>My History</PageTitle>

@if (AuthStateService.CurrentUser?.Role != "Customer")
{
    <section class="dashboard-card vp-access-denied">
        <p class="status-text">Customer access required.</p>
    </section>
}
else
{
    <section class="admin-page-head">
        <div>
            <h1 class="admin-page-title">My History</h1>
            <p class="subtitle">Your past purchases and service appointments.</p>
        </div>
    </section>

    @if (_isLoading)
    {
        <section class="dashboard-card">
            <LoadingSkeleton AccessibilityMessage="Loading customer purchase and service history." Lines="4" />
        </section>
    }
    else
    {
        <section class="dashboard-card mb-3">
            <h2 class="h5 mb-3">Purchase history (@_purchases.Count)</h2>

            @if (_purchases.Count == 0)
            {
                <EmptyState Icon="-" Title="No purchases recorded" Message="Invoices created by staff will appear here once you buy parts." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Total</th>
                                <th>Payment</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in _purchases)
                            {
                                <tr>
                                    <td>@inv.SalesInvoiceId</td>
                                    <td>@inv.InvoiceDate.ToLocalTime().ToString("g")</td>
                                    <td>
                                        @if (inv.Lines.Count == 0)
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            <ul class="mb-0 ps-3">
                                                @foreach (var line in inv.Lines)
                                                {
                                                    <li>@line.PartName x @line.Quantity (@NepalCurrency.Npr(line.LineTotal))</li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                    <td class="text-end">@NepalCurrency.Npr(inv.SubTotal)</td>
                                    <td class="text-end">@NepalCurrency.Npr(inv.DiscountAmount)</td>
                                    <td class="text-end">@NepalCurrency.Npr(inv.TotalAmount)</td>
                                    <td><span class="vp-tag vp-tag-info">@inv.PaymentType</span></td>
                                    <td>
                                        <span class="vp-tag @(string.Equals(inv.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase) ? "vp-tag-paid" : "vp-tag-pending")">
                                            @inv.PaymentStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dashboard-card">
            <h2 class="h5 mb-3">Service history (@_appointments.Count)</h2>

            @if (_appointments.Count == 0)
            {
                <EmptyState Icon="-" Title="No service visits yet" Message="Booked appointments and workshop records will appear in this section." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Vehicle</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in _appointments)
                            {
                                <tr>
                                    <td>@appt.AppointmentId</td>
                                    <td>@appt.VehicleLabel</td>
                                    <td>@appt.AppointmentDate.ToLocalTime().ToString("g")</td>
                                    <td><span class="vp-tag vp-tag-neutral">@appt.Status</span></td>
                                    <td>@appt.ServiceNote</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private List<CustomerPurchaseHistoryItemDto> _purchases = [];
    private List<CustomerAppointmentDto> _appointments = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthStateService.IsLoggedIn || AuthStateService.CurrentUser is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!string.Equals(AuthStateService.CurrentUser.Role, "Customer", StringComparison.OrdinalIgnoreCase))
        {
            _isLoading = false;
            return;
        }

        var token = AuthStateService.CurrentUser.Token;
        _purchases = await AuthApiService.GetCustomerPurchaseHistoryAsync(token);
        _appointments = await AuthApiService.GetCustomerAppointmentsAsync(token);
        _isLoading = false;
    }
}

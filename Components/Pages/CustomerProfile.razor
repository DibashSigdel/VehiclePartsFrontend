@page "/customer/profile"
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>My Profile</PageTitle>

<section class="dashboard-card">
    <h1>My Profile</h1>
    <p class="subtitle">Manage your customer profile details.</p>

    @if (!_canAccessPage)
    {
        <p class="status-text">Only customer accounts can access this page.</p>
    }
    else
    {
        @if (_isLoadingProfile)
        {
            <p class="status-text mb-3">Loading your saved details from the server…</p>
        }

        <EditForm Model="_model" OnValidSubmit="HandleSave" FormName="CustomerProfileForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
            </div>

            <div class="mb-3">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" />
            </div>

            <div class="mb-3">
                <label>Phone</label>
                <InputText class="form-control" @bind-Value="_model.Phone" />
            </div>

            <div class="mb-3">
                <label>Address</label>
                <InputText class="form-control" @bind-Value="_model.Address" />
            </div>

            <div class="mb-3">
                <label>New Password (optional)</label>
                <InputText class="form-control" @bind-Value="_model.NewPassword" type="password" />
            </div>

            <button class="btn btn-primary" type="submit" disabled="@(_isSaving || _isLoadingProfile)">
                @(_isSaving ? "Saving..." : "Save Profile")
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="mt-3 status-text">@_message</p>
        }
    }
</section>

@code {
    private readonly CustomerUpdateProfileRequestDto _model = new();
    private bool _isLoadingProfile = true;
    private bool _isSaving;
    private bool _canAccessPage;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthStateService.IsLoggedIn || AuthStateService.CurrentUser is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!string.Equals(AuthStateService.CurrentUser.Role, "Customer", StringComparison.OrdinalIgnoreCase))
        {
            _canAccessPage = false;
            _isLoadingProfile = false;
            return;
        }

        _canAccessPage = true;
        // Pre-fill from login so the form is never empty while the API loads.
        _model.Name = AuthStateService.CurrentUser.Name;
        _model.Email = AuthStateService.CurrentUser.Email;
        _model.Phone = string.Empty;
        _model.Address = string.Empty;
        _model.NewPassword = string.Empty;

        var token = AuthStateService.CurrentUser.Token;
        var profile = await AuthApiService.GetCustomerProfileAsync(token);

        if (profile is null)
        {
            _message = "Could not load profile from the server. Check that the backend is running and you are logged in as a customer.";
            _isLoadingProfile = false;
            return;
        }

        _model.Name = profile.Name;
        _model.Email = profile.Email;
        _model.Phone = profile.Phone;
        _model.Address = profile.Address;
        _model.NewPassword = string.Empty;
        _isLoadingProfile = false;
    }

    private async Task HandleSave()
    {
        if (AuthStateService.CurrentUser is null)
        {
            return;
        }

        _isSaving = true;
        _message = string.Empty;

        var success = await AuthApiService.UpdateCustomerProfileAsync(_model, AuthStateService.CurrentUser.Token);
        _isSaving = false;

        if (!success)
        {
            _message = "Profile update failed. Please verify your details.";
            return;
        }

        AuthStateService.CurrentUser.Name = _model.Name;
        AuthStateService.CurrentUser.Email = _model.Email;
        AuthStateService.SetUser(AuthStateService.CurrentUser);

        _model.NewPassword = string.Empty;
        _message = "Profile updated successfully.";
    }
}

@page "/customer/register"
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>Customer Registration</PageTitle>

<section class="auth-card">
    <h1>Customer Self Registration</h1>
    <p class="subtitle">Create your customer account to track and manage your details.</p>

    <EditForm Model="_model" OnValidSubmit="HandleRegister" FormName="CustomerRegisterForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" />
        </div>

        <div class="mb-3">
            <label>Phone</label>
            <InputText class="form-control" @bind-Value="_model.Phone" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" @bind-Value="_model.Password" type="password" />
        </div>

        <div class="mb-3">
            <label>Address</label>
            <InputText class="form-control" @bind-Value="_model.Address" />
        </div>

        <button class="btn btn-success w-100" type="submit" disabled="@_isLoading">
            @(_isLoading ? "Registering..." : "Create Customer Account")
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="mt-3 status-text">@_message</p>
    }
</section>

@code {
    private readonly CustomerSelfRegisterRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    protected override void OnInitialized()
    {
        if (AuthStateService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleRegister()
    {
        _isLoading = true;
        _message = string.Empty;

        var success = await AuthApiService.RegisterCustomerSelfAsync(_model);
        _isLoading = false;

        if (!success)
        {
            _message = "Registration failed. Please verify your details and use a unique email.";
            return;
        }

        _message = "Customer account created successfully. Please login.";
        NavigationManager.NavigateTo("/login");
    }
}

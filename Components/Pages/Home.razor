@page "/"
@inject AuthStateService AuthStateService

<PageTitle>Home</PageTitle>

<h1>Vehicle Parts System</h1>

<p>Frontend is connected to backend auth APIs.</p>

@if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser is not null)
{
    <p>Logged in as: <strong>@AuthStateService.CurrentUser.Name</strong> (@AuthStateService.CurrentUser.Role)</p>
}
else
{
    <p>Please use Register or Login from the left menu.</p>
}

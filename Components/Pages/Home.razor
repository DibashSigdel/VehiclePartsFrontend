@page "/"
@inject AuthStateService AuthStateService

<PageTitle>Home</PageTitle>

<section class="dashboard-card">
    <h1>Vehicle Parts System</h1>
    <p class="subtitle">Simple management portal for users, staff, and admin operations.</p>

    @if (AuthStateService.IsLoggedIn && AuthStateService.CurrentUser is not null)
    {
        <div class="status-chip success">
            Signed in as @AuthStateService.CurrentUser.Name (@AuthStateService.CurrentUser.Role)
        </div>
    }
    else
    {
        <div class="status-chip neutral">
            You are not logged in. Use Register or Login from the menu.
        </div>
    }
</section>

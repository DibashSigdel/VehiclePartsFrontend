@page "/login"
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<EditForm Model="_model" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_model.Email" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText class="form-control" @bind-Value="_model.Password" type="password" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@_isLoading">Login</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="mt-3">@_message</p>
}

@code {
    private readonly LoginRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _message = string.Empty;

        var response = await AuthApiService.LoginAsync(_model);
        _isLoading = false;

        if (response is null)
        {
            _message = "Login failed. Check your email and password.";
            return;
        }

        AuthStateService.SetUser(response);
        _message = $"Welcome back, {response.Name} ({response.Role}).";
        NavigationManager.NavigateTo("/");
    }
}

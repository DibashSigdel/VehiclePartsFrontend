@page "/login"
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<section class="auth-card">
    <h1>Login</h1>
    <p class="subtitle">Access your account to manage vehicle parts data.</p>

    <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="LoginForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" @bind-Value="_model.Password" type="password" />
        </div>

        <button class="btn btn-primary w-100" type="submit" disabled="@_isLoading">
            @(_isLoading ? "Logging in..." : "Login")
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="mt-3 status-text">@_message</p>
    }
</section>

@code {
    private readonly LoginRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    protected override void OnInitialized()
    {
        if (AuthStateService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _message = string.Empty;

        AuthResponseDto? response;
        try
        {
            response = await AuthApiService.LoginAsync(_model);
        }
        catch (HttpRequestException)
        {
            _isLoading = false;
            _message = "Cannot reach the API. Start the backend with: dotnet run --launch-profile http (http://localhost:5173).";
            return;
        }

        _isLoading = false;

        if (response is null)
        {
            _message = "Login failed. Check your email and password.";
            return;
        }

        AuthStateService.SetUser(response);
        _message = $"Welcome back, {response.Name} ({response.Role}).";
        NavigationManager.NavigateTo("/");
    }
}

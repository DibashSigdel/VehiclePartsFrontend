@page "/login"
@layout AuthLayout
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>Sign in</PageTitle>

<AuthPageShell Title="Sign in" Subtitle="Use your work email to access the Vehicle Parts portal.">
    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="LoginForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="mb-3" />

            <div class="auth-field">
                <label class="auth-label" for="login-email">Email</label>
                <InputText id="login-email" class="form-control auth-input" @bind-Value="_model.Email" autocomplete="username" placeholder="you@example.com" />
            </div>

            <div class="auth-field">
                <label class="auth-label" for="login-password">Password</label>
                <InputText id="login-password" class="form-control auth-input" @bind-Value="_model.Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
            </div>

            <button class="btn btn-primary w-100 auth-submit" type="submit" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="auth-btn-spinner" aria-hidden="true"></span>
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="auth-inline-message auth-inline-message--err">@_message</p>
        }
    </ChildContent>
    <Footer>
        <p class="auth-foot-note">
            New customer?
            <a href="customer/register">Create a customer account</a>
        </p>
        <p class="auth-foot-note auth-foot-note--muted">
            Staff or admin without an account? Ask an administrator to register you.
        </p>
    </Footer>
</AuthPageShell>

@code {
    private readonly LoginRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    protected override void OnInitialized()
    {
        if (AuthStateService.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _message = string.Empty;

        AuthResponseDto? response;
        try
        {
            response = await AuthApiService.LoginAsync(_model);
        }
        catch (HttpRequestException)
        {
            _isLoading = false;
            _message = "Cannot reach the API. Start the backend (e.g. dotnet run on port 5173).";
            return;
        }

        _isLoading = false;

        if (response is null)
        {
            _message = "Invalid email or password. Try again.";
            return;
        }

        AuthStateService.SetUser(response);
        _message = $"Welcome back, {response.Name}.";
        NavigationManager.NavigateTo("/");
    }
}

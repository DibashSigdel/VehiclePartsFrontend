@page "/register"
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<EditForm Model="_model" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_model.Email" />
    </div>

    <div class="mb-3">
        <label>Phone</label>
        <InputText class="form-control" @bind-Value="_model.Phone" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText class="form-control" @bind-Value="_model.Password" type="password" />
    </div>

    <div class="mb-3">
        <label>Role</label>
        <InputSelect class="form-control" @bind-Value="_model.Role">
            <option value="Customer">Customer</option>
            <option value="Staff">Staff</option>
            <option value="Admin">Admin</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Address</label>
        <InputText class="form-control" @bind-Value="_model.Address" />
    </div>

    <button class="btn btn-success" type="submit" disabled="@_isLoading">Register</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="mt-3">@_message</p>
}

@code {
    private readonly RegisterRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    private async Task HandleRegister()
    {
        _isLoading = true;
        _message = string.Empty;

        var response = await AuthApiService.RegisterAsync(_model);
        _isLoading = false;

        if (response is null)
        {
            _message = "Registration failed. Check inputs or use another email.";
            return;
        }

        AuthStateService.SetUser(response);
        _message = $"Registered successfully. Logged in as {response.Role}.";
        NavigationManager.NavigateTo("/");
    }
}

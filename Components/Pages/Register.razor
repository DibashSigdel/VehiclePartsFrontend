@page "/register"
@inject AuthApiService AuthApiService
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<section class="auth-card">
    <h1>Register User</h1>
    <p class="subtitle">Create a new user account in the system.</p>

    <EditForm Model="_model" OnValidSubmit="HandleRegister" FormName="RegisterForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" />
        </div>

        <div class="mb-3">
            <label>Phone</label>
            <InputText class="form-control" @bind-Value="_model.Phone" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" @bind-Value="_model.Password" type="password" />
        </div>

        <div class="mb-3">
            <label>Role</label>
            <InputSelect class="form-control" @bind-Value="_model.Role">
                <option value="Admin">Admin</option>
                <option value="Staff">Staff</option>
                <option value="Customer">Customer</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label>Address</label>
            <InputText class="form-control" @bind-Value="_model.Address" />
        </div>

        <button class="btn btn-success w-100" type="submit" disabled="@_isLoading">
            @(_isLoading ? "Registering..." : "Register")
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="mt-3 status-text">@_message</p>
    }
</section>

@code {
    private readonly RegisterRequestDto _model = new();
    private bool _isLoading;
    private string _message = string.Empty;

    private async Task HandleRegister()
    {
        _isLoading = true;
        _message = string.Empty;

        var response = await AuthApiService.RegisterAsync(_model);
        _isLoading = false;

        if (response is null)
        {
            _message = "Registration failed. Check inputs or use another email.";
            return;
        }

        _message = "Registered successfully. Please login with your new account.";
        NavigationManager.NavigateTo("/login");
    }
}

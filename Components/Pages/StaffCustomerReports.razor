@page "/staff/customer-reports"
@rendermode InteractiveServer
@inject AuthApiService AuthApiService
@inject AuthStateService AuthStateService

<PageTitle>Customer reports</PageTitle>

@if (AuthStateService.CurrentUser?.Role is not ("Staff" or "Admin"))
{
    <section class="dashboard-card">
        <p class="status-text">Staff or Admin access required.</p>
    </section>
}
else
{
    <section class="admin-page-head">
        <div>
            <h1 class="admin-page-title">Customer reports</h1>
            <p class="subtitle">Top spenders, regular customers, and overdue credit payments.</p>
        </div>
    </section>

    <section class="dashboard-card mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Rows per list</label>
                <InputNumber class="form-control" TValue="int" @bind-Value="_limit" min="1" max="100" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="button" disabled="@_isLoading" @onclick="LoadReportsAsync">
                    @(_isLoading ? "Loading…" : "Refresh reports")
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mt-3 status-alert error">@_error</p>
        }
    </section>

    @if (_reports is not null)
    {
        <section class="dashboard-card mb-3">
            <h2 class="h5 mb-3">Top spenders</h2>
            @if (_reports.TopSpenders.Count == 0)
            {
                <p class="subtitle">No sales data yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th class="text-end">Invoices</th>
                                <th class="text-end">Total spent</th>
                                <th>Last purchase</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _reports.TopSpenders)
                            {
                                <tr>
                                    <td>@row.CustomerName<br /><small class="text-muted">@row.Email</small></td>
                                    <td>@row.Phone</td>
                                    <td class="text-end">@row.InvoiceCount</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.TotalSpent)</td>
                                    <td>@(row.LastPurchaseDate?.ToLocalTime().ToString("d") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dashboard-card mb-3">
            <h2 class="h5 mb-3">Regular customers (2+ purchases)</h2>
            @if (_reports.RegularCustomers.Count == 0)
            {
                <p class="subtitle">No repeat customers yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th class="text-end">Invoices</th>
                                <th class="text-end">Total spent</th>
                                <th>Last purchase</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _reports.RegularCustomers)
                            {
                                <tr>
                                    <td>@row.CustomerName</td>
                                    <td>@row.Phone</td>
                                    <td class="text-end">@row.InvoiceCount</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.TotalSpent)</td>
                                    <td>@(row.LastPurchaseDate?.ToLocalTime().ToString("d") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="dashboard-card">
            <h2 class="h5 mb-3">Overdue credit payments</h2>
            @if (_reports.OverdueCredits.Count == 0)
            {
                <p class="subtitle">No overdue pending credits.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-users-table">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th class="text-end">Amount</th>
                                <th>Due date</th>
                                <th class="text-end">Days overdue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _reports.OverdueCredits)
                            {
                                <tr>
                                    <td>@row.SalesInvoiceId</td>
                                    <td>@row.CustomerName</td>
                                    <td>@row.Phone</td>
                                    <td class="text-end">@NepalCurrency.Npr(row.TotalAmount)</td>
                                    <td>@(row.CreditDueDate?.ToLocalTime().ToString("d") ?? "—")</td>
                                    <td class="text-end">@row.DaysOverdue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private int _limit = 20;
    private StaffCustomerReportsDto? _reports;
    private bool _isLoading;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateService.CurrentUser?.Role is "Staff" or "Admin"
            && !string.IsNullOrEmpty(AuthStateService.CurrentUser.Token))
        {
            await LoadReportsAsync();
        }
    }

    private async Task LoadReportsAsync()
    {
        if (AuthStateService.CurrentUser?.Token is null)
        {
            return;
        }

        if (_limit < 1)
        {
            _limit = 1;
        }
        else if (_limit > 100)
        {
            _limit = 100;
        }

        _isLoading = true;
        _error = string.Empty;
        _reports = null;

        _reports = await AuthApiService.GetStaffCustomerReportsAsync(
            AuthStateService.CurrentUser.Token,
            _limit);

        if (_reports is null)
        {
            _error = "Could not load reports. Check you are logged in and the API is running.";
        }

        _isLoading = false;
    }
}